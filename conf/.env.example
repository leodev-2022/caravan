# Copy to /opt/hub/.env on the hub (root-only, chmod 600). Never commit.
# Keys used by compose interpolation and tools/status.py.

# --- Headscale ---
# Preauth key to onboard nodes (generate per node, short-lived):
#   docker exec headscale headscale preauthkeys create --user caravan --reusable --expiration 24h
CODENOMAD_HS_KEY=hskey-auth-REPLACE_ME

# --- Portal / Telegram alerts ---
TELEGRAM_TOKEN=REPLACE_ME
TELEGRAM_CHAT=REPLACE_ME

# --- Node onboarding defaults (used by node-join.sh) ---
# HEADSCALE_URL=https://mesh.example.com
